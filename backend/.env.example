# ============================================================================
# ResearchOS Backend Configuration
# ============================================================================
# Copy this file to backend/.env and fill in your values.
# Do NOT commit backend/.env to version control.
# After editing backend/.env, RESTART the backend for changes to take effect.

# App
APP_NAME=ResearchOS
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/researchos.db

# Security (change these in production)
SECRET_KEY=change-me-to-a-random-secret-string
JWT_SECRET_KEY=change-me-to-another-random-secret-string

# CORS (comma-separated origins — keep localhost ports for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# AI Provider
AI_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=

# Vector store & file storage
VECTOR_STORE_PATH=./data/vector_store
UPLOAD_DIR=./data/uploads

# ============================================================================
# Email / OTP Configuration (Brevo)
# ============================================================================
#
# EMAIL_PROVIDER options:
#   "brevo"   — Sends transactional email via Brevo REST API v3 (Recommended)
#   "smtp"    — Sends real email via SMTP (Brevo SMTP relay, Gmail, etc.)
#   "console" — Prints OTP to the backend terminal (local development)
#
# Brevo API Configuration:
#   EMAIL_PROVIDER=brevo
#   BREVO_API_KEY=<secret>
#   EMAIL_FROM=ResearchOS <verified-sender@domain.com>

EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=ResearchOS <verified@domain.com>

# ============================================================================
# SMTP Configuration (REQUIRED when EMAIL_PROVIDER=smtp)
# ============================================================================
#
# Any standard SMTP provider works. NEVER commit real credentials.

# ---- Gmail ----
# Gmail requires a Gmail App Password (NOT your regular Gmail password).
#
# How to create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required before App Passwords appear)
#   3. Go to https://myaccount.google.com/apppasswords
#      (or search "App passwords" in Google Account settings)
#   4. Select app: "Mail", select device: "Other (Custom name)" → type "ResearchOS"
#   5. Click "Generate"
#   6. Copy the 16-character password (spaces will be removed automatically)
#   7. Paste it as SMTP_PASSWORD below (without spaces)
#
# Example:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youremail@gmail.com
#   SMTP_PASSWORD=abcd efgh ijkl mnop      (16-character App Password)
#   SMTP_FROM=youremail@gmail.com
#
# NOTE: SMTP_FROM must match SMTP_USERNAME for Gmail.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Brevo (brevo.com / formerly Sendinblue) ----
# SMTP host: smtp-relay.brevo.com, Port: 587 (STARTTLS)
# SMTP Password is your SMTP key (NOT your Brevo login password).
# Get your SMTP key from: https://app.brevo.com/settings/keys/smtp
# SMTP_FROM must be a verified sender in your Brevo account.
#
# Example:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-brevo-email@example.com
#   SMTP_PASSWORD=your-brevo-smtp-key
#   SMTP_FROM=your-verified-sender@example.com

# ---- Outlook / Microsoft 365 ----
# Example:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youremail@outlook.com
#   SMTP_PASSWORD=your-password-or-app-password
#   SMTP_FROM=youremail@outlook.com

# ---- Generic SMTP ----
# Works with any SMTP server that supports STARTTLS on port 587.
# Example:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-smtp-username
#   SMTP_PASSWORD=your-smtp-password
#   SMTP_FROM=noreply@example.com

# ============================================================================
# Other Settings
# ============================================================================

# Database Reset (set to "1" to reset all data on startup — DEVELOPMENT ONLY)
RESEARCHOS_RESET_DB=0

# Voice Provider
VOICE_PROVIDER=mock

# Follow-up settings
FOLLOWUP_ENABLED=True
FOLLOWUP_DEFAULT_DAYS=7
