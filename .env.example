# ResearchOS Backend Configuration
# Copy this file to backend/.env and fill in your values.
# Do NOT commit .env to version control.

# App
APP_NAME=ResearchOS
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/researchos.db

# Security
SECRET_KEY=change-me-to-a-random-secret-string
JWT_SECRET_KEY=change-me-to-another-random-secret-string

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# AI Provider
AI_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=

# Vector store & file storage
VECTOR_STORE_PATH=./data/vector_store
UPLOAD_DIR=./data/uploads

# ============================================================================
# Email / OTP Configuration (Brevo)
# ============================================================================
#
# Options:
#   "brevo"   — Sends transactional email via Brevo REST API v3 (Recommended)
#   "smtp"    — Sends real email via SMTP (Brevo, Gmail, etc.)
#   "console" — Prints OTP to the backend terminal (local development)
#
# Brevo API Configuration:
#   EMAIL_PROVIDER=brevo
#   BREVO_API_KEY=<secret>
#   EMAIL_FROM=ResearchOS <verified@domain.com>

EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=ResearchOS <verified@domain.com>

# ============================================================================
# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
# ============================================================================
#
# Any standard SMTP provider works. Below are common examples.
# NEVER commit real credentials to version control.

# ---- Brevo (brevo.com / sendinblue) ----
# SMTP host: smtp-relay.brevo.com
# Port: 587 (STARTTLS)
# Login: your Brevo SMTP login (your account email)
# Password: your SMTP key (NOT your Brevo login password — get it from
#           https://app.brevo.com/settings/keys/smtp)
# From: must be a verified sender in your Brevo account
#
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-email@example.com
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=your-verified-sender@example.com

# ---- Gmail ----
# Requires a Gmail App Password (NOT your regular Gmail password):
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App passwords" in Google Account settings
#   4. Create a new app password for "Mail"
#   5. Use the 16-character password below as SMTP_PASSWORD
#
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com

# ---- Outlook / Microsoft 365 ----
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@outlook.com
# SMTP_PASSWORD=your-password-or-app-password
# SMTP_FROM=your-email@outlook.com

# ---- Generic SMTP ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Database Reset (set to "1" to reset all data on startup — DEVELOPMENT ONLY)
RESEARCHOS_RESET_DB=0

# Voice Provider
VOICE_PROVIDER=mock

# Follow-up settings
FOLLOWUP_ENABLED=True
FOLLOWUP_DEFAULT_DAYS=7
